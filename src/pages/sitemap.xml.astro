---
export const prerender = true;

const site = 'https://landofstoneflowers.com';
const now = new Date().toISOString().split('T')[0];

const pages = [
  { url: '/',    lang: 'en', changefreq: 'monthly', priority: '1.0' },
  { url: '/ru/', lang: 'ru', changefreq: 'monthly', priority: '0.9' },
  { url: '/ja/', lang: 'ja', changefreq: 'monthly', priority: '0.9' },
];
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {pages.map(page => (
    <url>
      <loc>{site}{page.url}</loc>
      <lastmod>{now}</lastmod>
      <changefreq>{page.changefreq}</changefreq>
      <priority>{page.priority}</priority>
      <xhtml:link rel="alternate" hreflang="en"       href={`${site}/`} />
      <xhtml:link rel="alternate" hreflang="ru"       href={`${site}/ru/`} />
      <xhtml:link rel="alternate" hreflang="ja"       href={`${site}/ja/`} />
      <xhtml:link rel="alternate" hreflang="x-default" href={`${site}/`} />
    </url>
  ))}
</urlset>
