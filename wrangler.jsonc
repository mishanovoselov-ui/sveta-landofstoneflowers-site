{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sveta-landofstoneflowers-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "PREORDERS",
      "database_name": "landofstoneflowers-preorders",
      "database_id": "9c63bc0c-28a2-4d0d-a577-d697cc7ffe54"
    }
  ]
}
